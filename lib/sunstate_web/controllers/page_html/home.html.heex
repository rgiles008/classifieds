<Layouts.app flash={@flash} current_user={@conn.assigns[:current_user]}>
  <%!-- Hero Section --%>
  <div class="text-center py-12 sm:py-20">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">
      Buy & Sell in <span class="text-primary">Florida</span>
    </h1>
    <p class="mt-4 text-lg text-base-content/70 max-w-2xl mx-auto">
      SunState Classifieds is your local marketplace for finding great deals
      on everything from electronics to vehicles — no fees, just connections.
    </p>
    <div class="mt-8 flex gap-4 justify-center">
      <a href="/listings" class="btn btn-primary btn-lg">
        Browse Listings
      </a>
      <%= if !@conn.assigns[:current_user] do %>
        <a href="/users/register" class="btn btn-outline btn-lg">
          Get Started
        </a>
      <% else %>
        <a href="/listings/new" class="btn btn-outline btn-lg">
          Post a Listing
        </a>
      <% end %>
    </div>
  </div>

  <%!-- Categories Grid --%>
  <div class="py-12">
    <h2 class="text-2xl font-bold text-center mb-8">Browse by Category</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      <%= for category <- @categories do %>
        <a
          href={"/listings?category=#{category.slug}"}
          class="flex flex-col items-center gap-3 p-6 rounded-xl bg-base-200/50 hover:bg-base-200 transition-colors border border-base-200 hover:border-primary/30"
        >
          <span class={[category.icon, "size-8 text-primary"]}></span>
          <span class="font-medium text-sm text-center">{category.name}</span>
        </a>
      <% end %>
    </div>
  </div>

  <%!-- Recent Listings --%>
  <div class="py-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold">Recent Listings</h2>
      <a href="/listings" class="btn btn-ghost btn-sm">
        View all <span class="hero-arrow-right size-4 ml-1"></span>
      </a>
    </div>
    <%= if @recent_listings == [] do %>
      <div class="text-center py-12 text-base-content/50">
        <span class="hero-rectangle-stack size-12 mx-auto block mb-4"></span>
        <p class="text-lg">No listings yet</p>
        <p class="text-sm mt-2">Be the first to post something!</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <%= for listing <- @recent_listings do %>
          <a
            href={"/listings/#{listing.id}"}
            class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-200"
          >
            <figure class="h-48 bg-base-200 flex items-center justify-center">
              <span class="hero-photo size-16 text-base-content/20"></span>
            </figure>
            <div class="card-body p-4">
              <h3 class="card-title text-base line-clamp-1">{listing.title}</h3>
              <p class="text-lg font-bold text-primary">
                <%= cond do %>
                  <% listing.price_type == "free" -> %>
                    Free
                  <% listing.price -> %>
                    ${Decimal.round(listing.price, 2)}
                  <% true -> %>
                    Contact for price
                <% end %>
              </p>
              <div class="flex items-center gap-2 text-sm text-base-content/60">
                <span class="hero-map-pin-micro size-4"></span>
                <span>{listing.city || listing.zip_code}, {listing.state}</span>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>

  <%!-- How It Works --%>
  <div class="py-12">
    <h2 class="text-2xl font-bold text-center mb-8">How It Works</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="hero-magnifying-glass size-8 text-primary"></span>
        </div>
        <h3 class="font-semibold text-lg">Find What You Need</h3>
        <p class="text-base-content/60 mt-2">Browse thousands of listings across Florida. Filter by category, location, and price.</p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="hero-chat-bubble-left-right size-8 text-primary"></span>
        </div>
        <h3 class="font-semibold text-lg">Connect with Sellers</h3>
        <p class="text-base-content/60 mt-2">Message sellers directly through our secure messaging system. No phone number required.</p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="hero-hand-thumb-up size-8 text-primary"></span>
        </div>
        <h3 class="font-semibold text-lg">Make the Deal</h3>
        <p class="text-base-content/60 mt-2">Meet locally, inspect the item, and complete the transaction. No fees or commissions.</p>
      </div>
    </div>
  </div>

  <%!-- Footer --%>
  <footer class="border-t border-base-200 pt-8 pb-4 mt-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-base-content/50">
      <p>&copy; 2026 SunState Classifieds. All rights reserved.</p>
      <div class="flex gap-6">
        <span>Florida's Local Marketplace</span>
      </div>
    </div>
  </footer>
</Layouts.app>
